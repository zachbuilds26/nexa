# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# server logs (prodserver/devserver output lives in the repo root)
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# screenshots & QA captures - never ship
*-check.png
*-mobile.png
*-positions.png
*-deposits.png
/docs/SCREENSHOTS/
public/*-preview.png
public/trade-card.png

# admin app - separate Next.js project (admin/)
/admin/node_modules/
/admin/.next/
/admin/data/
/admin/install.log

# shared activity log + site data
/data/

# private planning docs
/BUILD_PLAN.md

.env*
# env templates are safe to commit
!.env.local.example
!/admin/.env.local.example

# agent tooling installed by integrations
/.agents/
/.claude/
/skills-lock.json
