# Binance Web3 API - https://web3.binance.com/en/dev-portal
# Needed for live trade quotes and swaps (/api/binance proxy). Read-only
# pages and public RWA market data work without keys. NEVER commit real keys.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=

# Optional: override the public BSC RPC used for protocol reads
NEXT_PUBLIC_BSC_RPC=https://bsc.publicnode.com

# Optional: enable the WalletConnect connector
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: canonical site URL for link previews and OG metadata
NEXT_PUBLIC_SITE_URL=

# Optional: admin console origin, enables the live notification bell and
# maintenance banner (admin app runs on port 3001)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
