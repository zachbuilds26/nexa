# Binance Web3 API - https://web3.binance.com/en/dev-portal (API keys page)
# Only needed for the home-page spread ticker (/api/binance proxy);
# everything else works without keys. NEVER commit this file (gitignored).
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=

# Optional: override the public BSC RPC used for protocol reads
NEXT_PUBLIC_BSC_RPC=https://bsc.publicnode.com
